# ─────────────────────────────────────────────────────────────────
# DED Platform · Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security ──────────────────────────────────────────────────────
# Change this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=kadm-ded-change-this-in-production

# ── Claude AI ─────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com
# The platform works without this key — AI chat will show a prompt
# to enter a key in the browser instead.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use for AI analysis (claude-sonnet-4-6 is recommended)
CLAUDE_MODEL=claude-sonnet-4-6

# Max tokens Claude returns per response
CLAUDE_MAX_TOKENS=2048

# ── Database ──────────────────────────────────────────────────────
# Leave blank to use default location (db/ded_platform.db)
DB_PATH=

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
